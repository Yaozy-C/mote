{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mote",
  "version": "0.5.1",
  "identifier": "com.mote.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mote",
        "width": 1440,
        "height": 1024,
        "minWidth": 920,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true
      },
      {
        "label": "about",
        "title": "About Mote",
        "url": "index.html?view=about",
        "width": 420,
        "height": 315,
        "minWidth": 420,
        "minHeight": 315,
        "maxWidth": 420,
        "maxHeight": 315,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": [
      "models/PP-OCRv5_mobile_det_fp16.mnn",
      "models/PP-OCRv5_mobile_rec_fp16.mnn",
      "models/ppocr_keys_v5.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "A warm, private clipboard history.",
    "longDescription": "Mote stores clipboard history locally so copied text stays searchable and easy to reuse.",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NDM1N0Y2Mjk1NzIxMTEKUldRUklWY3A5bGREaFl6QkVPNUVCYldiZ1BmeVBFRE02Ukh0dDArTWNKWWVwV1JLOTZWWXZsRzAK",
      "endpoints": [
        "https://github.com/Yaozy-C/mote/releases/latest/download/latest.json"
      ]
    }
  }
}
