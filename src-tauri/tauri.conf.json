{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mote",
  "version": "0.1.0",
  "identifier": "com.mote.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mote",
        "width": 1440,
        "height": 1024,
        "minWidth": 920,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A warm, private clipboard history.",
    "longDescription": "Mote stores clipboard history locally so copied text stays searchable and easy to reuse."
  }
}
