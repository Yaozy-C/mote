{
  "name": "mote",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:run": "node scripts/run-signed-macos.mjs",
    "desktop:build": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false,\"macOS\":{\"signingIdentity\":null}}}'",
    "desktop:bundle:dmg": "tauri build --bundles dmg --config '{\"bundle\":{\"createUpdaterArtifacts\":false,\"macOS\":{\"signingIdentity\":null}}}'"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
